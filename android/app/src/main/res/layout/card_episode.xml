<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:background="@drawable/card_focus"
    android:padding="4dp">

    <FrameLayout
        android:layout_width="320dp"
        android:layout_height="180dp">

        <ImageView
            android:id="@+id/card_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/default_thumb"
            android:scaleType="centerCrop"
            android:contentDescription="@string/browse_title" />

        <View
            android:id="@+id/progress_track"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_gravity="bottom"
            android:background="#66000000" />

        <View
            android:id="@+id/progress_fill"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_gravity="bottom|start"
            android:background="#E5322D" />
    </FrameLayout>

    <TextView
        android:id="@+id/card_title"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:paddingStart="2dp"
        android:paddingTop="6dp"
        android:paddingEnd="2dp"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/card_subtitle"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:paddingStart="2dp"
        android:paddingBottom="6dp"
        android:paddingEnd="2dp"
        android:textColor="#9AA3C4"
        android:textSize="12sp" />
</LinearLayout>
